html_code = '''<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Shopping PK - مکمل آن لائن شاپنگ سسٹم</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --daraz-orange: #f85606;
            --daraz-dark: #d04300;
            --bg-light: #f4f4f6;
            --text-dark: #212121;
            --green: #25D366;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', 'Noto Nastaliq Urdu', sans-serif;
        }
        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            padding-bottom: 70px;
        }
        /* Top Bar */
        .top-strip {
            background: #212121;
            color: #fff;
            font-size: 12px;
            padding: 6px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .top-strip button {
            background: rgba(255,255,255,0.15);
            border: none;
            color: #fff;
            padding: 3px 10px;
            border-radius: 4px;
            font-size: 12px;
            cursor: pointer;
        }
        /* Header */
        header {
            background-color: var(--daraz-orange);
            color: white;
            padding: 12px 15px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 8px rgba(0,0,0,0.18);
        }
        .header-main {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        .logo {
            font-size: 20px;
            font-weight: 700;
            direction: ltr;
            white-space: nowrap;
        }
        .header-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .icon-btn {
            background: white;
            color: var(--daraz-orange);
            border: none;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            position: relative;
        }
        .cart-badge {
            background: #212121;
            color: white;
            border-radius: 50%;
            padding: 1px 6px;
            font-size: 11px;
            margin-right: 4px;
        }
        .search-bar {
            width: 100%;
            padding: 9px 14px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
        }

        /* Categories Bar */
        .categories {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 12px 12px 4px;
            scrollbar-width: none;
        }
        .categories::-webkit-scrollbar { display: none; }
        .cat-btn {
            background: white;
            border: 1px solid #e0e0e0;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            white-space: nowrap;
            cursor: pointer;
            font-weight: 600;
        }
        .cat-btn.active {
            background: var(--daraz-orange);
            color: white;
            border-color: var(--daraz-orange);
        }

        /* Banner & Flash Sale */
        .banner {
            background: linear-gradient(135deg, #ff512f, #dd2476);
            color: white;
            padding: 16px;
            margin: 10px 12px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .banner h2 { font-size: 18px; margin-bottom: 4px; }
        .banner p { font-size: 12px; opacity: 0.95; }
        .timer-box {
            background: rgba(0,0,0,0.25);
            padding: 8px 12px;
            border-radius: 8px;
            text-align: center;
            direction: ltr;
            font-weight: 700;
            font-size: 14px;
        }

        /* Product Grid */
        .section-title {
            padding: 8px 15px;
            font-size: 17px;
            font-weight: 700;
        }
        .products-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding: 0 12px;
        }
        @media (min-width: 768px) {
            .products-grid {
                grid-template-columns: repeat(4, 1fr);
                max-width: 1150px;
                margin: 0 auto;
            }
        }
        .product-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .img-wrapper {
            position: relative;
            width: 100%;
            height: 170px;
            background: #fafafa;
            cursor: pointer;
        }
        .img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .discount-tag {
            position: absolute;
            top: 8px;
            left: 8px;
            background: var(--daraz-orange);
            color: white;
            font-size: 11px;
            font-weight: bold;
            padding: 2px 7px;
            border-radius: 4px;
            direction: ltr;
        }
        .product-info { padding: 10px; }
        .product-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            line-height: 1.5;
            cursor: pointer;
        }
        .current-price {
            color: var(--daraz-orange);
            font-size: 16px;
            font-weight: 700;
            direction: ltr;
            display: inline-block;
        }
        .old-price {
            color: #9e9e9e;
            font-size: 12px;
            text-decoration: line-through;
            margin-right: 5px;
            direction: ltr;
            display: inline-block;
        }
        .rating { font-size: 12px; color: #faca51; margin: 4px 0 8px; }
        .rating span { color: #757575; }
        .btn-group {
            display: flex;
            gap: 6px;
        }
        .add-cart-btn {
            flex: 1;
            background: #fff0e8;
            color: var(--daraz-orange);
            border: 1px solid var(--daraz-orange);
            padding: 7px 4px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .buy-now-btn {
            flex: 1;
            background: var(--daraz-orange);
            color: white;
            border: none;
            padding: 7px 4px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        /* Modals */
        .modal {
            display: none;
            position: fixed;
            z-index: 999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.65);
            align-items: center;
            justify-content: center;
            padding: 12px;
            overflow-y: auto;
        }
        .modal-content {
            background: white;
            width: 100%;
            max-width: 480px;
            border-radius: 12px;
            padding: 18px;
            position: relative;
            max-height: 90vh;
            overflow-y: auto;
        }
        .close-btn {
            position: absolute;
            top: 10px;
            left: 15px;
            font-size: 26px;
            cursor: pointer;
            color: #555;
        }
        .modal h3 { color: var(--daraz-orange); margin-bottom: 12px; font-size: 18px; }

        /* Cart Items */
        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
            padding: 8px 0;
            gap: 8px;
        }
        .cart-item-info { flex: 1; font-size: 13px; }
        .qty-controls { display: flex; align-items: center; gap: 6px; }
        .qty-controls button {
            width: 24px;
            height: 24px;
            border: 1px solid #ccc;
            background: #f9f9f9;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        /* Forms */
        .form-group { margin-bottom: 10px; }
        .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 3px; }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 9px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
        }
        .primary-btn {
            width: 100%;
            background: var(--daraz-orange);
            color: white;
            border: none;
            padding: 11px;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 6px;
        }
        .whatsapp-btn {
            width: 100%;
            background: var(--green);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
        }

        /* Admin & Tracking Cards */
        .order-record {
            background: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            font-size: 13px;
        }
        .status-pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
            background: #fff3cd;
            color: #856404;
        }
        .status-delivered { background: #d4edda; color: #155724; }
        .status-shipped { background: #cce5ff; color: #004085; }

        /* Bottom Mobile Nav */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: white;
            border-top: 1px solid #ddd;
            display: flex;
            justify-content: space-around;
            padding: 8px 0;
            z-index: 90;
        }
        .bottom-nav button {
            background: none;
            border: none;
            font-size: 12px;
            font-weight: 600;
            color: #444;
            cursor: pointer;
        }
        .toast {
            position: fixed;
            bottom: 65px;
            left: 50%;
            transform: translateX(-50%);
            background: #212121;
            color: white;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 13px;
            display: none;
            z-index: 1000;
        }
    </style>
</head>
<body>

    <!-- Top Strip -->
    <div class="top-strip">
        <span>🇵🇰 پورے پاکستان میں کیش آن ڈیلیوری (COD)</span>
        <div>
            <button onclick="openTrackModal()">📦 آرڈر ٹریک کریں</button>
            <button onclick="openAdminModal()">⚙️ ایڈمن پینل</button>
        </div>
    </div>

    <!-- Header -->
    <header>
        <div class="header-main">
            <div class="logo">Smart Shopping PK</div>
            <div class="header-actions">
                <button class="icon-btn" onclick="openCartModal()">
                    🛒 کارٹ <span class="cart-badge" id="cartCount">0</span>
                </button>
            </div>
        </div>
        <input type="text" id="searchInput" class="search-bar" placeholder="پروڈکٹ تلاش کریں (مثلاً: بیگ، گھڑی، ایئربڈز)..." onkeyup="renderProducts()">
    </header>

    <!-- Categories -->
    <div class="categories" id="categoryBar">
        <button class="cat-btn active" onclick="filterCategory('all', this)">تمام پروڈکٹس</button>
        <button class="cat-btn" onclick="filterCategory('bags', this)">لیڈیز بیگز</button>
        <button class="cat-btn" onclick="filterCategory('electronics', this)">الیکٹرانکس</button>
        <button class="cat-btn" onclick="filterCategory('fashion', this)">فیشن و ایکسیسریز</button>
    </div>

    <!-- Banner -->
    <div class="banner">
        <div>
            <h2>میگا فلیش سیل! 40% تک بچت</h2>
            <p>پہلے پارسل چیک کریں، پھر رقم ادا کریں</p>
        </div>
        <div class="timer-box" id="saleTimer">05h : 42m : 18s</div>
    </div>

    <!-- Products -->
    <div class="section-title">خاص آپ کے لیے (Just For You)</div>
    <div class="products-grid" id="productsGrid"></div>

    <!-- Product Detail Modal -->
    <div class="modal" id="detailModal">
        <div class="modal-content" id="detailContent"></div>
    </div>

    <!-- Cart & Checkout Modal -->
    <div class="modal" id="cartModal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal('cartModal')">&times;</span>
            <h3>آپ کا شاپنگ کارٹ اور آرڈر فارم</h3>
            <div id="cartItemsList"></div>
            <div id="cartSummary" style="background:#fff5f0; padding:10px; border-radius:6px; margin:10px 0; font-size:14px;"></div>

            <form id="checkoutForm" onsubmit="placeOrder(event)">
                <div class="form-group">
                    <label>پورا نام *</label>
                    <input type="text" id="custName" required placeholder="اپنا نام لکھیں">
                </div>
                <div class="form-group">
                    <label>موبائل / واٹس ایپ نمبر *</label>
                    <input type="tel" id="custPhone" required placeholder="03XXXXXXXXX">
                </div>
                <div class="form-group">
                    <label>شہر کا نام *</label>
                    <input type="text" id="custCity" required placeholder="مثلاً: لاہور، کراچی، پشاور">
                </div>
                <div class="form-group">
                    <label>مکمل پتہ (گھر نمبر، گلی، مشہور جگہ) *</label>
                    <textarea id="custAddress" rows="2" required placeholder="مکمل ایڈریس درج کریں"></textarea>
                </div>
                <button type="submit" class="whatsapp-btn">آرڈر بک کریں اور واٹس ایپ پر بھیجیں ✅</button>
            </form>
        </div>
    </div>

    <!-- Order Tracking Modal -->
    <div class="modal" id="trackModal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal('trackModal')">&times;</span>
            <h3>اپنا آرڈر ٹریک کریں 📦</h3>
            <div class="form-group">
                <label>آرڈر آئی ڈی (Order ID) یا فون نمبر درج کریں:</label>
                <input type="text" id="trackInput" placeholder="مثلاً: SSP-1024 یا 03001234567">
            </div>
            <button class="primary-btn" onclick="trackOrder()">اسٹیٹس چیک کریں</button>
            <div id="trackResult" style="margin-top:12px;"></div>
        </div>
    </div>

    <!-- Admin Panel Modal -->
    <div class="modal" id="adminModal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal('adminModal')">&times;</span>
            <h3>ایڈمن پینل (Smart Shopping PK) ⚙️</h3>
            <div id="adminLoginBox">
                <div class="form-group">
                    <label>ایڈمن پاسورڈ درج کریں (ڈیفالٹ: 1234)</label>
                    <input type="password" id="adminPass" placeholder="پاسورڈ لکھیں">
                </div>
                <button class="primary-btn" onclick="loginAdmin()">لاگ ان کریں</button>
            </div>

            <div id="adminDashboard" style="display:none;">
                <div style="display:flex; gap:6px; margin-bottom:12px;">
                    <button class="cat-btn active" onclick="showAdminTab('ordersTab')">تمام آرڈرز</button>
                    <button class="cat-btn" onclick="showAdminTab('addProdTab')">+ نیا پروڈکٹ لگائیں</button>
                </div>

                <!-- Orders Tab -->
                <div id="ordersTab">
                    <div id="adminOrdersList"></div>
                </div>

                <!-- Add Product Tab -->
                <div id="addProdTab" style="display:none;">
                    <form onsubmit="addNewProduct(event)">
                        <div class="form-group">
                            <label>پروڈکٹ کا نام *</label>
                            <input type="text" id="newProdName" required placeholder="مثلاً: لیدر ہینڈ بیگ">
                        </div>
                        <div class="form-group">
                            <label>کیٹیگری</label>
                            <select id="newProdCat">
                                <option value="bags">لیڈیز بیگز</option>
                                <option value="electronics">الیکٹرانکس</option>
                                <option value="fashion">فیشن و ایکسیسریز</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>سیل قیمت (Rs) *</label>
                            <input type="number" id="newProdPrice" required placeholder="1499">
                        </div>
                        <div class="form-group">
                            <label>پرانی قیمت (Rs)</label>
                            <input type="number" id="newProdOldPrice" placeholder="2200">
                        </div>
                        <div class="form-group">
                            <label>تصویر کا لنک (Image URL) *</label>
                            <input type="url" id="newProdImg" required placeholder="https://...">
                        </div>
                        <div class="form-group">
                            <label>تفصیل (Description)</label>
                            <textarea id="newProdDesc" rows="2" placeholder="پروڈکٹ کی کوالٹی اور سائز لکھیں"></textarea>
                        </div>
                        <button type="submit" class="primary-btn">اسٹور میں شامل کریں ✅</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Nav -->
    <div class="bottom-nav">
        <button onclick="window.scrollTo({top:0, behavior:'smooth'})">🏠 ہوم</button>
        <button onclick="openCartModal()">🛒 کارٹ (<span id="bottomCartCount">0</span>)</button>
        <button onclick="openTrackModal()">📦 ٹریک آرڈر</button>
        <button onclick="openAdminModal()">⚙️ ایڈمن</button>
    </div>

    <div class="toast" id="toastMsg"></div>

    <script>
        const STORE_WHATSAPP = "923433335740";
        const DELIVERY_FEE = 200;
        let currentCategory = "all";

        // Default Products
        const defaultProducts = [
            {
                id: 1,
                name: "پریمیم ٹین ماربل ٹوٹ بیگ (Tan Marble Tote Bag)",
                category: "bags",
                price: 1499,
                oldPrice: 2300,
                discount: "-35%",
                rating: "★★★★★ (142)",
                img: "https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=500&q=80",
                desc: "اعلیٰ معیار کا پریمیم لیدر ماربل ٹوٹ بیگ، مضبوط زپ اور کشادہ اندرونی حصے کے ساتھ۔ یونیورسٹی، آفس اور روزمرہ استعمال کے لیے بہترین۔"
            },
            {
                id: 2,
                name: "الٹرا اسمارٹ واچ کالنگ فیچر کے ساتھ",
                category: "electronics",
                price: 2199,
                oldPrice: 3600,
                discount: "-40%",
                rating: "★★★★★ (98)",
                img: "https://images.unsplash.com/photo-1546868871-7041f2a55e12?auto=format&fit=crop&w=500&q=80",
                desc: "بڑی ایچ ڈی اسکرین، بلوٹوتھ کالنگ، ہارٹ ریٹ مانیٹر اور لمبی بیٹری لائف۔ اینڈرائیڈ اور آئی فون دونوں کے ساتھ کام کرتی ہے۔"
            },
            {
                id: 3,
                name: "وائرلیس بلوٹوتھ ایئربڈز (Hi-Fi ساؤنڈ)",
                category: "electronics",
                price: 1299,
                oldPrice: 1850,
                discount: "-30%",
                rating: "★★★★☆ (215)",
                img: "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=500&q=80",
                desc: "کرسٹل کلیئر ساؤنڈ، فاسٹ چارجنگ کیس اور ٹچ کنٹرول کے ساتھ۔"
            },
            {
                id: 4,
                name: "مردانہ خالص لیدر والٹ (Classic Wallet)",
                category: "fashion",
                price: 899,
                oldPrice: 1200,
                discount: "-25%",
                rating: "★★★★★ (76)",
                img: "https://images.unsplash.com/photo-1627123424574-724758594e93?auto=format&fit=crop&w=500&q=80",
                desc: "مضبوط سلائی اور متعدد کارڈ پاکٹس کے ساتھ پائیدار مردانہ بٹوہ۔"
            }
        ];

        let products = JSON.parse(localStorage.getItem("ssp_products")) || defaultProducts;
        let cart = JSON.parse(localStorage.getItem("ssp_cart")) || [];
        let orders = JSON.parse(localStorage.getItem("ssp_orders")) || [];

        function showToast(msg) {
            const t = document.getElementById("toastMsg");
            t.innerText = msg;
            t.style.display = "block";
            setTimeout(() => { t.style.display = "none"; }, 2200);
        }

        function renderProducts() {
            const query = document.getElementById("searchInput").value.toLowerCase();
            const grid = document.getElementById("productsGrid");
            grid.innerHTML = "";

            const filtered = products.filter(p => {
                const matchCat = currentCategory === "all" || p.category === currentCategory;
                const matchSearch = p.name.toLowerCase().includes(query);
                return matchCat && matchSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = "<p style='grid-column:1/-1; text-align:center; padding:20px;'>کوئی پروڈکٹ نہیں ملا۔</p>";
                return;
            }

            filtered.forEach(p => {
                grid.innerHTML += `
                <div class="product-card">
                    <div class="img-wrapper" onclick="openDetail(${p.id})">
                        <span class="discount-tag">${p.discount}</span>
                        <img src="${p.img}" alt="${p.name}">
                    </div>
                    <div class="product-info">
                        <div class="product-title" onclick="openDetail(${p.id})">${p.name}</div>
                        <div>
                            <span class="current-price">Rs. ${p.price}</span>
                            <span class="old-price">Rs. ${p.oldPrice}</span>
                        </div>
                        <div class="rating">${p.rating}</div>
                        <div class="btn-group">
                            <button class="add-cart-btn" onclick="addToCart(${p.id})">+ کارٹ</button>
                            <button class="buy-now-btn" onclick="buyNow(${p.id})">آرڈر کریں</button>
                        </div>
                    </div>
                </div>`;
            });
        }

        function filterCategory(cat, btn) {
            currentCategory = cat;
            document.querySelectorAll("#categoryBar .cat-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            renderProducts();
        }

        function openDetail(id) {
            const p = products.find(x => x.id === id);
            document.getElementById("detailContent").innerHTML = `
                <span class="close-btn" onclick="closeModal('detailModal')">&times;</span>
                <img src="${p.img}" style="width:100%; height:230px; object-fit:cover; border-radius:8px; margin-bottom:10px;">
                <h3>${p.name}</h3>
                <p style="margin-bottom:8px;">
                    <span class="current-price" style="font-size:20px;">Rs. ${p.price}</span>
                    <span class="old-price">Rs. ${p.oldPrice}</span>
                </p>
                <p style="font-size:13px; color:#555; line-height:1.6; margin-bottom:14px;">${p.desc}</p>
                <div class="btn-group">
                    <button class="add-cart-btn" style="padding:11px;" onclick="addToCart(${p.id}); closeModal('detailModal')">کارٹ میں ڈالیں</button>
                    <button class="buy-now-btn" style="padding:11px;" onclick="closeModal('detailModal'); buyNow(${p.id})">ابھی آرڈر کریں</button>
                </div>
            `;
            document.getElementById("detailModal").style.display = "flex";
        }

        function updateCartBadges() {
            const count = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById("cartCount").innerText = count;
            document.getElementById("bottomCartCount").innerText = count;
            localStorage.setItem("ssp_cart", JSON.stringify(cart));
        }

        function addToCart(id) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.qty += 1;
            } else {
                const prod = products.find(p => p.id === id);
                cart.push({ id: prod.id, name: prod.name, price: prod.price, qty: 1 });
            }
            updateCartBadges();
            showToast("پروڈکٹ کارٹ میں شامل ہو گیا!");
        }

        function buyNow(id) {
            const prod = products.find(p => p.id === id);
            cart = [{ id: prod.id, name: prod.name, price: prod.price, qty: 1 }];
            updateCartBadges();
            openCartModal();
        }

        function openCartModal() {
            renderCart();
            document.getElementById("cartModal").style.display = "flex";
        }

        function renderCart() {
            const list = document.getElementById("cartItemsList");
            const summary = document.getElementById("cartSummary");
            const form = document.getElementById("checkoutForm");

            if (cart.length === 0) {
                list.innerHTML = "<p style='text-align:center; padding:15px; color:#777;'>آپ کا کارٹ خالی ہے۔</p>";
                summary.style.display = "none";
                form.style.display = "none";
                return;
            }

            summary.style.display = "block";
            form.style.display = "block";
            list.innerHTML = "";
            let subtotal = 0;

            cart.forEach((item, index) => {
                subtotal += item.price * item.qty;
                list.innerHTML += `
                <div class="cart-item">
                    <div class="cart-item-info">
                        <strong>${item.name}</strong><br>
                        <span style="color:#f85606;">Rs. ${item.price} × ${item.qty}</span>
                    </div>
                    <div class="qty-controls">
                        <button onclick="changeQty(${index}, -1)">-</button>
                        <span>${item.qty}</span>
                        <button onclick="changeQty(${index}, 1)">+</button>
                    </div>
                </div>`;
            });

            const grandTotal = subtotal + DELIVERY_FEE;
            summary.innerHTML = `
                <div>پروڈکٹس کی قیمت: <strong>Rs. ${subtotal}</strong></div>
                <div>ڈیلیوری چارجز: <strong>Rs. ${DELIVERY_FEE}</strong></div>
                <div style="font-size:16px; margin-top:4px; color:#f85606;">کل واجب الادا رقم (COD): <strong>Rs. ${grandTotal}</strong></div>
            `;
        }

        function changeQty(index, delta) {
            cart[index].qty += delta;
            if (cart[index].qty <= 0) cart.splice(index, 1);
            updateCartBadges();
            renderCart();
        }

        function placeOrder(e) {
            e.preventDefault();
            if (cart.length === 0) return;

            const name = document.getElementById("custName").value;
            const phone = document.getElementById("custPhone").value;
            const city = document.getElementById("custCity").value;
            const address = document.getElementById("custAddress").value;

            const subtotal = cart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const total = subtotal + DELIVERY_FEE;
            const orderId = "SSP-" + Math.floor(1000 + Math.random() * 9000);

            const itemsText = cart.map(i => `• ${i.name} (${i.qty} عدد) - Rs. ${i.price * i.qty}`).join("\n");

            const newOrder = {
                id: orderId,
                name, phone, city, address,
                items: itemsText,
                total,
                status: "زیرِ غور (Pending)",
                date: new Date().toLocaleDateString('ur-PK')
            };

            orders.unshift(newOrder);
            localStorage.setItem("ssp_orders", JSON.stringify(orders));

            const waMessage =
`*نیا آرڈر - Smart Shopping PK* 🛍️
*آرڈر آئی ڈی:* ${orderId}
---------------------------
${itemsText}
*ڈیلیوری چارجز:* Rs. ${DELIVERY_FEE}
*کل بل (COD):* Rs. ${total}
---------------------------
*کسٹمر:* ${name}
*فون:* ${phone}
*شہر:* ${city}
*پتہ:* ${address}
---------------------------
براہ کرم میرا آرڈر کنفرم کر دیں!`;

            cart = [];
            updateCartBadges();
            closeModal("cartModal");
            alert(`مبارک ہو! آپ کا آرڈر بک ہو گیا ہے۔\nآپ کی آرڈر آئی ڈی: ${orderId}\nاب آپ کو واٹس ایپ پر بھیجا جا رہا ہے۔`);

            const waUrl = `https://wa.me/${STORE_WHATSAPP}?text=${encodeURIComponent(waMessage)}`;
            window.open(waUrl, "_blank");
        }

        // Tracking
        function openTrackModal() {
            document.getElementById("trackModal").style.display = "flex";
        }
        function trackOrder() {
            const q = document.getElementById("trackInput").value.trim().toLowerCase();
            const res = document.getElementById("trackResult");
            const found = orders.filter(o => o.id.toLowerCase() === q || o.phone.includes(q));

            if (found.length === 0) {
                res.innerHTML = "<p style='color:red; font-size:13px;'>اس نمبر یا آئی ڈی پر کوئی آرڈر نہیں ملا۔</p>";
                return;
            }
            res.innerHTML = found.map(o => `
                <div class="order-record">
                    <strong>آرڈر آئی ڈی:</strong> ${o.id} <span class="status-pill">${o.status}</span><br>
                    <strong>نام:</strong> ${o.name} (${o.city})<br>
                    <strong>کل رقم:</strong> Rs. ${o.total}<br>
                    <small>${o.items.replace(/\n/g, "<br>")}</small>
                </div>
            `).join("");
        }

        // Admin Panel
        function openAdminModal() {
            document.getElementById("adminModal").style.display = "flex";
        }
        function loginAdmin() {
            const pass = document.getElementById("adminPass").value;
            if (pass === "1234") {
                document.getElementById("adminLoginBox").style.display = "none";
                document.getElementById("adminDashboard").style.display = "block";
                renderAdminOrders();
            } else {
                alert("غلط پاسورڈ!");
            }
        }
        function showAdminTab(tabId) {
            document.getElementById("ordersTab").style.display = tabId === "ordersTab" ? "block" : "none";
            document.getElementById("addProdTab").style.display = tabId === "addProdTab" ? "block" : "none";
        }
        function renderAdminOrders() {
            const list = document.getElementById("adminOrdersList");
            if (orders.length === 0) {
                list.innerHTML = "<p style='font-size:13px; color:#666;'>ابھی تک کوئی آرڈر موصول نہیں ہوا۔</p>";
                return;
            }
            list.innerHTML = orders.map((o, idx) => `
                <div class="order-record">
                    <strong>${o.id}</strong> - ${o.name} (${o.phone})<br>
                    <strong>شہر:</strong> ${o.city} | <strong>بل:</strong> Rs. ${o.total}<br>
                    <small>${o.address}</small><br>
                    <div style="margin-top:6px;">
                        <select onchange="updateOrderStatus(${idx}, this.value)" style="padding:4px; font-size:12px;">
                            <option ${o.status.includes('Pending') ? 'selected' : ''}>زیرِ غور (Pending)</option>
                            <option ${o.status.includes('Shipped') ? 'selected' : ''}>روانہ کر دیا گیا (Shipped)</option>
                            <option ${o.status.includes('Delivered') ? 'selected' : ''}>ڈیلیور ہو گیا (Delivered)</option>
                        </select>
                    </div>
                </div>
            `).join("");
        }
        function updateOrderStatus(idx, val) {
            orders[idx].status = val;
            localStorage.setItem("ssp_orders", JSON.stringify(orders));
            showToast("آرڈر اسٹیٹس اپڈیٹ ہو گیا!");
        }
        function addNewProduct(e) {
            e.preventDefault();
            const price = parseInt(document.getElementById("newProdPrice").value);
            const oldPrice = parseInt(document.getElementById("newProdOldPrice").value) || Math.round(price * 1.3);
            const disc = "-" + Math.round(((oldPrice - price) / oldPrice) * 100) + "%";

            products.unshift({
                id: Date.now(),
                name: document.getElementById("newProdName").value,
                category: document.getElementById("newProdCat").value,
                price: price,
                oldPrice: oldPrice,
                discount: disc,
                rating: "★★★★★ (New)",
                img: document.getElementById("newProdImg").value,
                desc: document.getElementById("newProdDesc").value || "بہترین کوالٹی پروڈکٹ"
            });

            localStorage.setItem("ssp_products", JSON.stringify(products));
            renderProducts();
            e.target.reset();
            showToast("نیا پروڈکٹ اسٹور میں شامل ہو گیا!");
            showAdminTab("ordersTab");
        }

        function closeModal(id) {
            document.getElementById(id).style.display = "none";
        }

        // Countdown Timer
        let secondsLeft = 5 * 3600 + 42 * 60 + 18;
        setInterval(() => {
            if (secondsLeft > 0) secondsLeft--;
            const h = String(Math.floor(secondsLeft / 3600)).padStart(2, '0');
            const m = String(Math.floor((secondsLeft % 3600) / 60)).padStart(2, '0');
            const s = String(secondsLeft % 60).padStart(2, '0');
            document.getElementById("saleTimer").innerText = `${h}h : ${m}m : ${s}s`;
        }, 1000);

        // Init
        renderProducts();
        updateCartBadges();
    </script>
</body>
</html>
'''

with open("index.html", "w", encoding="utf-8") as f:
    f.write(html_code)

print("index.html created successfully")
